# Clés Groq (gratuites : console.groq.com/keys). Plusieurs clés séparées par des
# virgules : rotation automatique quand l'une atteint son quota.
GROQ_API_KEYS=gsk_xxx,gsk_yyy

# Optionnel
# GROQ_MODEL=openai/gpt-oss-120b     # modèle par défaut du chat (mode « Auto »)
# RATE_LIMIT_MAX=20                  # requêtes / minute / IP et par type d'appel
# MAX_HISTORY_MESSAGES=20            # messages d'historique envoyés au modèle
