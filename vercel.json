{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/code.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/tools.js": {
      "maxDuration": 60
    },
    "api/transcribe.js": {
      "maxDuration": 60
    },
    "api/speech.js": {
      "maxDuration": 30
    },
    "api/batch.js": {
      "maxDuration": 30
    },
    "api/models.js": {
      "maxDuration": 10
    },
    "api/share.js": {
      "maxDuration": 10
    }
  }
}